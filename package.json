{
  "name": "@smanx/dsh-proxy",
  "description": "DSH plugin (scoped package @smanx/dsh-proxy, matching the repository): LAN reverse proxy with native Basic Auth and a settings page. Source lives in this repo's dsh-proxy/ subdirectory; this root package makes the plugin installable from the repository itself (git/github: specs install the root).",
  "version": "0.1.14",
  "license": "MIT",
  "type": "module",
  "main": "dsh-proxy/lib/index.cjs",
  "exports": {
    ".": {
      "types": "./dsh-proxy/lib/types/index.d.ts",
      "default": "./dsh-proxy/lib/index.cjs"
    },
    "./client": {
      "types": "./dsh-proxy/lib/types/client/index.d.ts",
      "default": "./dsh-proxy/lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh-proxy/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "dsh-proxy/lib",
    "dsh-proxy/cordis.patch.yml",
    "dsh-proxy/dsh.plugin.json",
    "dsh-proxy/README.md",
    "dsh-proxy/README.zh.md",
    "dsh-proxy/LICENSE",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt"
  ],
  "repository": {
    "url": "git+https://github.com/vb2250158/dsh-proxy.git",
    "type": "git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0"
  },
  "icon": "./icon.svg"
}
